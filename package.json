{
  "name": "dsh-terse-mode",
  "version": "1.4.0",
  "description": "Four terse levels in the conversation header — less thinking, no web search, shorter answers — plus independent switches for reasoning effort, web search and subagents, mirrored in Settings. Changes apply immediately.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cspyz/dsh-terse-mode.git"
  },
  "homepage": "https://github.com/cspyz/dsh-terse-mode#readme",
  "bugs": {
    "url": "https://github.com/cspyz/dsh-terse-mode/issues"
  },
  "author": "cspyz",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "简洁模式 (dsh-terse-mode)",
    "description": "四档强度常驻对话页顶栏：不想太多、不联网、话更短；思考强度、联网搜索、子代理三个开关单独可调，设置页里有同一份，改完立即生效。"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "terse",
    "reasoning-effort",
    "web-search",
    "subagents"
  ],
  "license": "MIT"
}
